<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.webhook.platform</groupId>
        <artifactId>webhook-platform</artifactId>
        <version>2.7.0</version>
    </parent>

    <artifactId>webhook-platform-api</artifactId>
    <name>Webhook Platform API</name>
    <description>REST API for event ingestion and management</description>

    <dependencies>
        <dependency>
            <groupId>com.webhook.platform</groupId>
            <artifactId>webhook-platform-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!--
          Required as of Flyway 10 (bundled from Spring Boot 3.3+) -
          database support was split out of flyway-core into per-database
          modules. Without this, Flyway fails at startup with
          "Unsupported Database: PostgreSQL".
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 8.10.1 checked against Maven Central - already the latest
             release under the com.bucket4j coordinates; no bump needed. The
             project has since started publishing newer 8.x releases under
             io.github.bucket4j instead, which is a groupId/artifactId rename,
             not a compatibility requirement - left for a separate change. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>2.9.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!--
          Bumped to 28.4.0, the last version before stripe-java 29.0.0
          (2025-04-01, Stripe API "basil" 2025-03-31) removed
          Subscription#getCurrentPeriodStart/End() and Invoice#getSubscription()
          / #getPaymentIntent() in favor of SubscriptionItem-level periods and
          Invoice#getParent()/getPayments(). StripeBillingProvider uses all
          four. stripe-java is a plain HTTP client with no Spring/Java
          framework coupling, so nothing here is required for Spring Boot
          3.5/Java compatibility - going all the way to current (33.x) would
          mean rewriting the subscription/invoice period and payment-intent
          logic against Stripe's new object model, which needs its own
          reviewed change (and ideally a real Stripe sandbox to verify
          against), not a silent side effect of a framework upgrade.
        -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>28.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>3.52.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!--
          Bumped within the 5.x line only (latest is 5.16.0). ShedLock
          6.0.0 (2025) restructured lock-provider internals - e.g. multiple
          LockProvider support - and 7.0.0-RC1 moved DatabaseProduct to a new
          package and tightened SQL-provider error handling; neither release's
          notes confirm the net.javacrumbs.shedlock.core.{LockProvider,
          DefaultLockingTaskExecutor,LockingTaskExecutor} imports ShedLockConfig
          relies on are unaffected. Staying on the latest 5.x avoids betting
          that on an unverified assumption; revisit 6.x/7.x as its own
          reviewed change.
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>5.16.0</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>7.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 1.21.4 is already the latest 1.x release (matches Spring
             Boot 3.5's own managed Testcontainers baseline of 1.21.x).
             Testcontainers 2.0.0 is a new major line published in 2026 -
             out of scope here; left for a separate, dedicated change. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <!--
                  2.22.2 predates JUnit 5.9+'s OutputDirectoryProvider
                  API. With Spring Boot 3.5.16's newer managed JUnit Jupiter
                  version, that old surefire silently discovered zero tests
                  ("unaligned versions of the junit-platform-engine and
                  junit-platform-launcher jars") instead of failing loudly.
                -->
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <!--
              See the matching comment in webhook-platform-common's
              pom.xml for the shared rationale (merged exec file, `verify`
              phase choice). Two rules here, not one:

              1. BUNDLE - project floor for this module. Re-measured
                 2026-08-22 (unit + integration merged, 749 tests across 72
                 classes): INSTRUCTION 40.2% (43576/108405), up from 33.1%
                 at the 2026-08-21 baseline. Still by far the biggest module
                 (602 classes), which is why its bundle percentage sits below
                 worker's even though plenty of individual classes are well
                 covered. Floor set a few points under the measured value: a
                 gate pinned exactly at the current number goes red on
                 ordinary measurement jitter.
              2. CLASS - floors on the two api-side halves of the
                 ordering/delivery path (the rest - WebhookDeliveryService,
                 AttemptRunner, RetrySchedulerService, OrderingBufferService,
                 DeliveryConsumer - lives in webhook-platform-worker and has
                 its own CLASS rule there).

                 OutboxPublisherService: measured 74.7% on 2026-08-22, up
                 from 56.5%.

                 SequenceGeneratorService: measured 77.8%, up from 6.8%.
                 It used to be excluded from this rule on purpose, with the
                 note that a floor near its then-actual value would
                 rubber-stamp the gap instead of flagging it, and that it
                 should be added "once the class is actually tested". It now
                 is, so it is in.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.37</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.webhook.platform.api.service.OutboxPublisherService</include>
                                        <include>com.webhook.platform.api.service.SequenceGeneratorService</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
